<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Replace top-left navbar button to open Enterprise Home Client Action -->
    <t t-inherit="web.NavBar.AppsMenu" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_navbar_apps_menu')]" position="replace">
            <div class="o_navbar_apps_menu">
                <button class="btn o_enterprise_home_btn d-flex align-items-center justify-content-center border-0 bg-transparent text-white p-2"
                        t-on-click="onAllAppsBtnClick"
                        title="Home Menu"
                        data-hotkey="h">
                    <i class="oi oi-apps fs-4" />
                </button>
            </div>
        </xpath>
    </t>

    <!-- Enterprise Home Dashboard Client Action Template -->
    <t t-name="umi_enterprise_theme.EnterpriseHomeDashboard">
        <div class="o_enterprise_dashboard_container h-100 w-100 d-flex flex-column align-items-center justify-content-start overflow-auto p-4 position-absolute top-0 start-0">
            
            <!-- Header -->
            <div class="o_home_header w-100 max-w-1000 d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom border-secondary-subtle">
                <div class="d-flex align-items-center">
                    <span class="fs-1 fw-bolder text-white me-3">UMI ERP</span>
                    <span class="badge bg-primary fs-6 rounded-pill px-3 py-2">Enterprise Grid</span>
                </div>
            </div>

            <!-- Search Box -->
            <div class="o_home_search_box w-100 max-w-500 mb-5 position-relative">
                <i class="oi oi-search position-absolute top-50 translate-middle-y me-3 text-white-50 fs-5" style="right: 15px;"/>
                <input type="text"
                       class="form-control form-control-lg bg-dark text-white border-secondary rounded-pill pe-5 ps-4 fs-6 text-end shadow-lg"
                       placeholder="ابحث عن التطبيق..."
                       t-model="state.searchQuery"
                       autofocus="autofocus"/>
            </div>

            <!-- App Grid -->
            <div class="o_home_apps_grid w-100 max-w-1000">
                <t t-foreach="apps" t-as="app" t-key="app.id">
                    <div class="o_home_app_card text-center p-3 rounded-4 cursor-pointer"
                         t-on-click="() => this.selectApp(app)">
                        
                        <div class="o_home_app_icon_wrapper mx-auto mb-2 d-flex align-items-center justify-content-center rounded-4 shadow-lg">
                            <t t-set="iconUrl" t-value="getAppIconUrl(app)"/>
                            <t t-if="iconUrl">
                                <img class="o_home_app_icon_img" t-att-src="iconUrl" t-att-alt="app.name"/>
                            </t>
                            <t t-else="">
                                <div class="o_home_app_icon_fallback fw-bold text-white fs-2">
                                    <t t-esc="app.name[0]"/>
                                </div>
                            </t>
                        </div>

                        <span class="o_home_app_name text-white-50 fw-semibold fs-7 d-block" t-esc="app.name"/>
                    </div>
                </t>
            </div>

        </div>
    </t>

</templates>
