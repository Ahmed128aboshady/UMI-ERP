<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View for Gemini AI Copilot -->
    <record id="view_umi_gemini_ai_copilot_form" model="ir.ui.view">
        <field name="name">umi.gemini.ai.copilot.form</field>
        <field name="model">umi.gemini.ai.copilot</field>
        <field name="arch" type="xml">
            <form string="UMI Gemini AI Copilot">
                <header>
                    <button name="action_ask_gemini" string="🤖 اسأل Gemini AI الأن" type="object" class="btn-primary btn-lg"/>
                    <button name="action_quick_sales" string="📊 تحليل المبيعات والعقود" type="object" class="btn-secondary"/>
                    <button name="action_quick_projects" string="📁 حالة المشاريع والمهام" type="object" class="btn-secondary"/>
                    <button name="action_quick_hr" string="👥 أداء الموظفين والساعات" type="object" class="btn-secondary"/>
                    <button name="action_quick_marketing" string="💡 استشارة تسويقية للخدمات" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="عنوان الاستفسار"/>
                        <h1>
                            <field name="name" placeholder="مثال: تحليل مبيعات إعمار وشرطة دبي"/>
                        </h1>
                    </div>

                    <!-- Live KPI Cards -->
                    <group>
                        <group string="📊 ملخص النظام المباشر">
                            <field name="total_sales_amount" widget="monetary"/>
                            <field name="total_sales_count"/>
                            <field name="total_projects_count"/>
                        </group>
                        <group string="⚡ الأداء والإنتاجية">
                            <field name="total_timesheet_hours" widget="float"/>
                            <field name="total_tasks_count"/>
                            <field name="total_employees_count"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="🤖 اسأل Gemini AI" name="ask_page">
                            <group>
                                <field name="prompt" placeholder="اكتب سؤالك هنا باللغة العربية... (مثال: اعطني تحليلاً لكفاءة فريق الـ 3D، أو قارن بين أرباح مشروع إعمار وشرطة دبي)" rows="4"/>
                                <field name="api_key" password="True" placeholder="Google Gemini API Key (اختياري للربط الحقيقي بـ Gemini)"/>
                            </group>
                            <separator string="✨ إجابة وتوصيات Gemini AI الذكية"/>
                            <field name="response_html" widget="html" readonly="1" nolabel="1"/>
                        </page>
                        <page string="📄 النص الخام للإجابة" name="raw_text_page">
                            <field name="response_text" readonly="1" placeholder="النص الخام المرتجع من الذكاء الاصطناعي..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View for Gemini AI Copilot (Odoo 19 uses list tag) -->
    <record id="view_umi_gemini_ai_copilot_list" model="ir.ui.view">
        <field name="name">umi.gemini.ai.copilot.list</field>
        <field name="model">umi.gemini.ai.copilot</field>
        <field name="arch" type="xml">
            <list string="سجل استشارات Gemini AI">
                <field name="create_date" string="التاريخ"/>
                <field name="name"/>
                <field name="prompt"/>
                <field name="total_sales_amount" sum="إجمالي المبيعات"/>
                <field name="total_timesheet_hours" sum="إجمالي الساعات"/>
            </list>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_umi_gemini_ai_copilot" model="ir.actions.act_window">
        <field name="name">Gemini AI Copilot 🤖</field>
        <field name="res_model">umi.gemini.ai.copilot</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                مرحباً بك في UMI Gemini AI Copilot! 🤖
            </p>
            <p>
                اضغط على زر "جديد" أو اختر أحد أزرار التحليل السريع للبدء في تحليل المبيعات والمشاريع وساعات عمل الفريق فوراً.
            </p>
        </field>
    </record>

    <!-- Root Menu Item -->
    <menuitem id="menu_umi_gemini_ai_root"
              name="Gemini AI 🤖"
              sequence="5"
              web_icon="base,static/description/icon.png"
              action="action_umi_gemini_ai_copilot"/>

    <!-- Sub Menu Item -->
    <menuitem id="menu_umi_gemini_ai_copilot"
              name="استشارات Gemini AI"
              parent="menu_umi_gemini_ai_root"
              sequence="10"
              action="action_umi_gemini_ai_copilot"/>
</odoo>
